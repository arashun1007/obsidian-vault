// Cloudflare（wrangler deploy）用の設定。
// ゲーム（docs/isomoguri）を静的配信し、worker/index.js がランキングAPIを担当する。
// vault本体（日記・日報など）は配信対象に含めないこと。
{
  "name": "isomoguri",
  "compatibility_date": "2026-07-12",
  "main": "worker/index.js",
  "assets": {
    "directory": "./docs/isomoguri",
    "binding": "ASSETS"
  }
  // ランキングの保存先KV（ダッシュボードの isomoguri-rank）
  ,"kv_namespaces": [{ "binding": "RANK", "id": "c7af36ca31ad4b14a1712f6d4d3ccc31" }]
}
